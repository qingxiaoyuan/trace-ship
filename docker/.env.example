# Docker 第三方服务一键部署环境变量模板
# 复制为 .env 后按需修改

# 通用
COMPOSE_PROJECT_NAME=release-manager-dev
TIMEZONE=Asia/Shanghai

# 镜像前缀（默认留空，使用 Docker daemon 中配置的镜像加速器）
# 如需单独指定镜像源，可设置如下：
#   IMAGE_PREFIX=m.daocloud.io/docker.io/
#   IMAGE_PREFIX=registry.cn-hangzhou.aliyuncs.com/your-namespace/
IMAGE_PREFIX=

# PostgreSQL 16
POSTGRES_VERSION=16
POSTGRES_DB=release_manager
POSTGRES_USER=release_manager
POSTGRES_PASSWORD=ChangeMe_DB_2024
POSTGRES_PORT=5432

# Redis 7
REDIS_VERSION=7
REDIS_PASSWORD=ChangeMe_Redis_2024
REDIS_PORT=6379

# Gitea
GITEA_VERSION=1.21
GITEA_HTTP_PORT=13000
GITEA_SSH_PORT=2222
GITEA_DB_NAME=gitea
GITEA_DB_USER=gitea
GITEA_DB_PASSWORD=ChangeMe_GiteaDB_2024
GITEA_ADMIN_USER=gitea_admin
GITEA_ADMIN_PASSWORD=ChangeMe_GiteaAdmin_2024
GITEA_ADMIN_EMAIL=admin@example.com

# Jenkins
JENKINS_VERSION=lts
JENKINS_HTTP_PORT=18080
JENKINS_AGENT_PORT=50000
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=ChangeMe_Jenkins_2024

# OpenLDAP
LDAP_VERSION=1.4.0
LDAP_DOMAIN=example.com
LDAP_ADMIN_PASSWORD=ChangeMe_LDAP_2024
LDAP_PORT=389
LDAP_SSL_PORT=636

# phpLDAPadmin
PHPLDAPADMIN_PORT=18090

# SVN
SVN_VERSION=latest
SVN_PORT=3690
