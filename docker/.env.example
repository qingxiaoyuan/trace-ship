# Docker 第三方服务一键部署环境变量模板
# 复制为 .env 后按需修改

# 通用
COMPOSE_PROJECT_NAME=release-manager-dev
TIMEZONE=Asia/Shanghai

# 镜像前缀（默认留空，使用 Docker daemon 中配置的镜像加速器）
# 如需单独指定镜像源，可设置如下：
#   IMAGE_PREFIX=m.daocloud.io/docker.io/
#   IMAGE_PREFIX=registry.cn-hangzhou.aliyuncs.com/your-namespace/
IMAGE_PREFIX=

# PostgreSQL 16
POSTGRES_VERSION=16
POSTGRES_DB=release_manager
POSTGRES_USER=release_manager
POSTGRES_PASSWORD=ChangeMe_DB_2024
POSTGRES_PORT=5432

# Redis 7
REDIS_VERSION=7
REDIS_PASSWORD=ChangeMe_Redis_2024
REDIS_PORT=6379

# Gitea
GITEA_VERSION=1.21
GITEA_HTTP_PORT=13000
GITEA_SSH_PORT=2222
GITEA_DB_NAME=gitea
GITEA_DB_USER=gitea
GITEA_DB_PASSWORD=ChangeMe_GiteaDB_2024
GITEA_ADMIN_USER=gitea_admin
GITEA_ADMIN_PASSWORD=ChangeMe_GiteaAdmin_2024
GITEA_ADMIN_EMAIL=admin@example.com

# Jenkins
JENKINS_VERSION=lts
JENKINS_HTTP_PORT=18080
JENKINS_AGENT_PORT=50000
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=ChangeMe_Jenkins_2024

# OpenLDAP
LDAP_VERSION=1.4.0
LDAP_DOMAIN=example.com
LDAP_ADMIN_PASSWORD=ChangeMe_LDAP_2024
LDAP_PORT=389
LDAP_SSL_PORT=636

# phpLDAPadmin
PHPLDAPADMIN_PORT=18090

# SVN
SVN_VERSION=latest
SVN_PORT=3690

# Trace Ship Backend
BACKEND_PORT=8000
DJANGO_SECRET_KEY=3acbc069689435dcac3258c60af06ce726c5138d020e93206ba50e9e31b09f4299534190dc309685e4160cc885430fa704f2
CREDENTIAL_SECRET_KEY=bfba9db7e58d18c03b30fe50402815ca93a3bfe35ecc4fa900ebddd8d7c80d7b
ALLOWED_HOSTS=10.128.96.90,backend,localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=True

FRONTEND_PORT=8002

# 打包工作区根目录（宿主机路径，容器内外保持一致，用于 compose 变量插值）
PACKAGE_WORKSPACE_ROOT=/data/trace-ship/package_workspaces

# Nexus 仓库连接（打包镜像选择使用，可选）
NEXUS_BASE_URL=
NEXUS_USERNAME=
NEXUS_PASSWORD=
CORS_ALLOWED_ORIGINS=http://10.128.96.90
