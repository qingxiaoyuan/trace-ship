# Trace Ship 生产环境配置模板
# 复制为 .env.prod 并填写真实值后使用：cp .env.prod.example .env.prod
# 注意：.env.prod 包含敏感信息，切勿提交到 Git 仓库。

# ============ 通用 ============
COMPOSE_PROJECT_NAME=trace-ship
TIMEZONE=Asia/Shanghai
# 镜像前缀（默认留空，使用 Docker daemon 镜像加速器）
# 内网无法访问 Docker Hub 时可设置：IMAGE_PREFIX=m.daocloud.io/docker.io/
IMAGE_PREFIX=

# ============ PostgreSQL ============
POSTGRES_VERSION=16
POSTGRES_DB=release_manager
POSTGRES_USER=release_manager
# ⚠️ 必须修改为强密码
POSTGRES_PASSWORD=ChangeMe_StrongDB_Pwd_2024

# ============ Redis ============
REDIS_VERSION=7
# ⚠️ 必须修改为强密码
REDIS_PASSWORD=ChangeMe_StrongRedis_Pwd_2024

# ============ Django 安全配置 ============
# ⚠️ 必须修改为随机强密钥（>=50 字符）
#   生成方式：python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=must-replace-with-random-50-chars-secret-key-here
# ⚠️ 凭证加密密钥，必须为 32 字节随机串
#   生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
CREDENTIAL_SECRET_KEY=must-replace-with-32-bytes-random-key-here

# ============ 访问控制（IP 访问）============
# 允许访问后端的 Host 列表，逗号分隔，不能为 *
# 请把 YOUR_SERVER_IP 替换为实际服务器 IP；保留 backend/localhost/127.0.0.1 以保证容器内与本地调试可用
# 示例：ALLOWED_HOSTS=192.168.1.100,10.0.0.5,backend,localhost,127.0.0.1
ALLOWED_HOSTS=YOUR_SERVER_IP,backend,localhost,127.0.0.1

# CORS：生产必须为 False（prod.py 会校验）
CORS_ALLOW_ALL_ORIGINS=False
# 允许的前端来源，逗号分隔
# 前端使用 80 端口时填 http://YOUR_SERVER_IP；若 FRONTEND_PORT 非 80 则填 http://YOUR_SERVER_IP:端口
CORS_ALLOWED_ORIGINS=http://YOUR_SERVER_IP

# ============ 端口 ============
# 前端对外端口（默认 80，直接通过 http://服务器IP 访问）
# 若 80 端口被占用，可改为其他端口（如 8002），并同步修改 CORS_ALLOWED_ORIGINS
FRONTEND_PORT=80

# ============ 打包工作区（DooD 关键配置）============
# 打包任务工作区根目录，宿主机与容器内必须使用相同绝对路径。
# 原因：打包时通过 docker socket 调用宿主机 dockerd 启动构建容器，
#   -v 挂载路径需在宿主机真实存在，因此容器内外路径必须一致。
# 该目录会由 start-prod.sh 自动创建；如需改到其他路径，保持宿主机有写权限即可。
PACKAGE_WORKSPACE_ROOT=/data/trace-ship/package_workspaces

# ============ LDAP（可选，不填则使用本地账号认证）============
# LDAP_SERVER_URI=ldap://openldap:389
# LDAP_BIND_DN=cn=admin,dc=example,dc=com
# LDAP_BIND_PASSWORD=
# LDAP_USER_SEARCH_BASE=ou=users,dc=example,dc=com
