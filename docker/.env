# Docker 第三方服务一键部署环境变量
# 用于本地开发/测试，生产环境请修改

# 通用
COMPOSE_PROJECT_NAME=release-manager-dev
TIMEZONE=Asia/Shanghai

# 镜像前缀（默认留空，使用 Docker daemon 中配置的镜像加速器）
# 如需单独指定镜像源，可设置如下：
#   IMAGE_PREFIX=m.daocloud.io/docker.io/
#   IMAGE_PREFIX=registry.cn-hangzhou.aliyuncs.com/your-namespace/
IMAGE_PREFIX=

# PostgreSQL 16
POSTGRES_VERSION=16
POSTGRES_DB=release_manager
POSTGRES_USER=release_manager
POSTGRES_PASSWORD=ReleaseManager@2024
POSTGRES_PORT=5432

# Redis 7
REDIS_VERSION=7
REDIS_PASSWORD=ReleaseManager@2024
REDIS_PORT=6379

# Gitea
GITEA_VERSION=1.21
GITEA_HTTP_PORT=13000
GITEA_SSH_PORT=2222
GITEA_DB_NAME=gitea
GITEA_DB_USER=gitea
GITEA_DB_PASSWORD=Gitea@2024
GITEA_ADMIN_USER=admin
GITEA_ADMIN_PASSWORD=admin
GITEA_ADMIN_EMAIL=admin@example.com

# Jenkins
JENKINS_VERSION=lts
JENKINS_HTTP_PORT=18080
JENKINS_AGENT_PORT=50000
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=admin

# OpenLDAP
LDAP_VERSION=1.4.0
LDAP_DOMAIN=example.com
LDAP_ADMIN_PASSWORD=admin
LDAP_PORT=389
LDAP_SSL_PORT=636

# phpLDAPadmin
PHPLDAPADMIN_PORT=18090

# SVN
SVN_VERSION=latest
SVN_PORT=3690
SVN_HTTP_PORT=3691

# Trace Ship Backend
BACKEND_PORT=8000
DJANGO_SECRET_KEY=django-insecure-change-me-in-production
CREDENTIAL_SECRET_KEY=change-me-in-production-32bytes!
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=True

FRONTEND_PORT=8002
