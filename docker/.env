# Docker 第三方服务一键部署环境变量
# 用于本地开发/测试，生产环境请修改

# 通用
COMPOSE_PROJECT_NAME=trace-ship-dev
TIMEZONE=Asia/Shanghai

# 镜像前缀（默认留空，使用 Docker daemon 中配置的镜像加速器）
# 如需单独指定镜像源，可设置如下：
#   IMAGE_PREFIX=m.daocloud.io/docker.io/
#   IMAGE_PREFIX=registry.cn-hangzhou.aliyuncs.com/your-namespace/
IMAGE_PREFIX=

# PostgreSQL 16
POSTGRES_VERSION=16
POSTGRES_DB=release_manager
POSTGRES_USER=release_manager
POSTGRES_PASSWORD=ReleaseManager@2024
POSTGRES_PORT=5432

# Redis 7
REDIS_VERSION=7
REDIS_PASSWORD=ReleaseManager@2024
REDIS_PORT=6379

# GitLab 社区版（重量级，建议 4GB+ 可用内存，首次启动需等待数分钟）
GITLAB_IMAGE=gitlab/gitlab-ce
GITLAB_VERSION=14.10.5-ce.0
GITLAB_HTTP_PORT=18929
GITLAB_SSH_PORT=2224
GITLAB_ROOT_PASSWORD=GitlabAdmin@2024

# ===== 以下为测试环境模拟服务（--profile test 启动）=====

# OpenLDAP
LDAP_VERSION=1.4.0
LDAP_DOMAIN=example.com
LDAP_ADMIN_PASSWORD=admin
LDAP_PORT=389
LDAP_SSL_PORT=636

# phpLDAPadmin
PHPLDAPADMIN_PORT=18090

# SVN（打包产物推送模拟目标）
SVN_VERSION=latest
SVN_PORT=3690
SVN_HTTP_PORT=3691

# Trace Ship Backend
BACKEND_PORT=8000
DJANGO_SECRET_KEY=django-insecure-change-me-in-production
CREDENTIAL_SECRET_KEY=change-me-in-production-32bytes!
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=True

FRONTEND_PORT=8002
