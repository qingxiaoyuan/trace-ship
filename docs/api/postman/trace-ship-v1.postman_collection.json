{
  "info": {
    "_postman_id": "trace-ship-v1",
    "name": "Trace Ship API V1",
    "description": "软件版本发布管理系统 API V1。登录接口同时支持本地账号与 LDAP 账号（LDAP 参数在「系统配置」页面维护，环境变量兜底）。除登录、刷新 Token、健康检查外，其余接口均需携带 Authorization: Bearer {{access_token}}。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "认证",
      "item": [
        {
          "name": "登录（本地 / LDAP）",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{base_url}}/api/auth/login/",
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"admin\",\"password\":\"admin@123\"}"
            }
          }
        },
        {
          "name": "刷新 Token",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{base_url}}/api/auth/token/refresh/",
            "body": {
              "mode": "raw",
              "raw": "{\"refresh\":\"{{refresh_token}}\"}"
            }
          }
        },
        {
          "name": "登出",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{access_token}}"}
            ],
            "url": "{{base_url}}/api/auth/logout/",
            "body": {
              "mode": "raw",
              "raw": "{\"refresh\":\"{{refresh_token}}\"}"
            }
          }
        },
        {
          "name": "当前用户信息",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/api/auth/user-info/"
          }
        },
        {
          "name": "当前用户菜单",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/api/auth/menus/"
          }
        }
      ]
    },
    {
      "name": "用户与角色",
      "item": [
        {
          "name": "用户列表",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/api/account/users/"
          }
        },
        {
          "name": "创建用户",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{access_token}}"}
            ],
            "url": "{{base_url}}/api/account/users/",
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"newuser\",\"password\":\"newpass123\",\"nickname\":\"新用户\",\"source\":\"local\",\"is_active\":true}"
            }
          }
        },
        {
          "name": "管理员重置用户密码",
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{access_token}}"}
            ],
            "url": "{{base_url}}/api/account/users/{{user_id}}/",
            "body": {
              "mode": "raw",
              "raw": "{\"password\":\"newpass456\"}"
            }
          }
        },
        {
          "name": "角色列表",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/api/account/roles/"
          }
        },
        {
          "name": "权限列表",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/api/account/permissions/"
          }
        }
      ]
    },
    {
