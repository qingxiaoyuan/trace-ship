              "raw": "{\"code\":\"DEMO\",\"name\":\"演示项目\",\"description\":\"这是一个演示项目\",\"version_rule\":{\"format\":\"VA.{major}.{minor}.{patch}\",\"initial\":\"VA.1.0.0\"},\"release_rule\":{\"test_prefix\":\"test\",\"release_cycle_days\":3},\"status\":1}"
            }
