            "url": "{{base_url}}/api/repositories/{{repository_id}}/changes-preview/?branch=master"
          }
        },
        {
          "name": "仓库统计",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/api/repositories/stats/"
          }
        },
        {
          "name": "提交合规统计",
          "request": {
            "method": "GET",
