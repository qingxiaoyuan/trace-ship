    {
      "name": "工作流审批",
      "item": [
        {
          "name": "流程定义列表",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/api/workflow/definitions/"
          }
        },
        {
          "name": "流程实例列表",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/api/workflow/instances/"
          }
        },
        {
          "name": "我发起的流程",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/api/workflow/instances/initiated/"
          }
        },
        {
          "name": "撤销流程实例",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/api/workflow/instances/{{workflow_instance_id}}/revoke/"
          }
        },
        {
          "name": "待办任务",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/api/workflow/tasks/todo/"
          }
        },
        {
          "name": "已办任务",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/api/workflow/tasks/done/"
          }
        },
        {
          "name": "审批通过",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{access_token}}"}
            ],
            "url": "{{base_url}}/api/workflow/tasks/{{workflow_task_id}}/approve/",
            "body": {
              "mode": "raw",
              "raw": "{\"comment\":\"同意发布\"}"
            }
          }
        },
        {
          "name": "审批驳回",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{access_token}}"}
            ],
            "url": "{{base_url}}/api/workflow/tasks/{{workflow_task_id}}/reject/",
            "body": {
              "mode": "raw",
              "raw": "{\"comment\":\"请补充发布说明\"}"
            }
          }
        },
        {
          "name": "转交他人",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{access_token}}"}
            ],
            "url": "{{base_url}}/api/workflow/tasks/{{workflow_task_id}}/transfer/",
            "body": {
              "mode": "raw",
              "raw": "{\"to_user_id\":\"{{user_id}}\",\"comment\":\"请代为审批\"}"
            }
          }
        },
        {
          "name": "回退节点",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{access_token}}"}
            ],
            "url": "{{base_url}}/api/workflow/tasks/{{workflow_task_id}}/rollback/",
            "body": {
              "mode": "raw",
              "raw": "{\"comment\":\"回退到上一节点\"}"
            }
          }
        }
      ]
    },
    {
