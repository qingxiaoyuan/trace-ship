            "url": "{{base_url}}/api/credentials/types/"
          }
        }
      ]
    },
    {
      "name": "发布管理",
      "item": [
        {
          "name": "发布列表",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/api/releases/"
          }
        },
        {
          "name": "创建发布",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{access_token}}"}
            ],
            "url": "{{base_url}}/api/releases/",
            "body": {
              "mode": "raw",
              "raw": "{\"project\":\"{{project_id}}\",\"repository\":\"{{repository_id}}\",\"branch\":\"master\",\"release_type\":\"formal\",\"version\":\"\",\"tag_name\":\"\"}"
            }
          }
        },
        {
          "name": "发布详情",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/api/releases/{{release_id}}/"
          }
        },
        {
          "name": "生成发布说明",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{access_token}}"}
            ],
            "url": "{{base_url}}/api/releases/{{release_id}}/generate-doc/",
            "body": {
              "mode": "raw",
              "raw": "{\"commit_ids\":[],\"merge_similar\":true}"
            }
          }
        },
        {
          "name": "更新发布说明",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{access_token}}"}
            ],
            "url": "{{base_url}}/api/releases/{{release_id}}/update-doc/",
            "body": {
              "mode": "raw",
              "raw": "{\"release_doc\":\"# 发布说明\\n\\n## 新增功能\\n- 示例\"}"
            }
          }
        },
        {
          "name": "导出发布说明 Markdown",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": "{{base_url}}/api/releases/{{release_id}}/export-md/"
          }
        },
