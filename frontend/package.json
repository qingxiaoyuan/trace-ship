{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "scripts": {
    "check:runtime": "node scripts/check-runtime.mjs",
    "pretest:runtime": "npm run check:runtime",
    "test:runtime": "node --test scripts/*.test.mjs",
    "preinstall": "node scripts/check-runtime.mjs",
    "predev": "npm run check:runtime",
    "dev": "vite",
    "prebuild": "npm run check:runtime",
    "build": "tsc -b && vite build",
    "prelint": "npm run check:runtime",
    "lint": "eslint .",
    "prepreview": "npm run check:runtime",
    "preview": "vite preview",
    "pretest": "npm run check:runtime",
    "test": "vitest run",
    "pretest:watch": "npm run check:runtime",
    "test:watch": "vitest",
    "pretest:browser": "npm run check:runtime",
    "test:browser": "node ../scripts/checks/browser.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.5",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/chart.js": "^2.9.41",
    "ace-builds": "^1.44.0",
    "antd": "^6.4.5",
    "axios": "^1.18.0",
    "chart.js": "^4.5.1",
    "dayjs": "^1.11.21",
    "lucide-react": "^1.22.0",
    "react": "^19.2.6",
    "react-ace": "^15.0.0",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.11"
